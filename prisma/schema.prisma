model TransactionCC {
  id        String   @id @default(uuid()) @db.Uuid
  clubId    String   @map("club_id") @db.Uuid
  userId    String   @map("user_id")
  ccBefore  Int      @map("cc_before")
  ccMove    Int      @map("cc_move")
  ccAfter   Int      @map("cc_after")
  createdAt DateTime @default(now()) @map("created_at")
  type      Int
  note      String?

  clubData Club @relation(fields: [clubId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userData User @relation(fields: [userId], references: [id], onUpdate: Cascade)

  @@map("transaction_cc")
}

model TransactionRP {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String
  matchId    String?  @db.Uuid
  note       String?
  rpBefore   Int      @map("rp_before")
  rpMove     Int      @map("rp_move")
  rpAfter    Int      @map("rp_after")
  rtChange   Boolean  @default(false) @map("rt_change")
  rtIdBefore Int?     @map("rt_id_before")
  rtIdAfter  Int?     @map("rt_id_after")
  createdAt  DateTime @default(now()) @map("created_at")

  rtBeforeData RankTittle? @relation("oldRT", fields: [rtIdBefore], references: [id])
  rtAfterData  RankTittle? @relation("newRT", fields: [rtIdAfter], references: [id])
  matchData    Match?      @relation(fields: [matchId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  userData     User        @relation(fields: [userId], references: [id], onUpdate: Cascade)

  @@map("transaction_rp")
}

model Match {
  id               String   @id @default(uuid()) @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")
  matchAt          DateTime @map("match_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  typeId           Int      @map("type_id")
  deposit          Int      @default(0)
  clubId           String?  @map("club_id") @db.Uuid
  creatorMemberId  Int?     @map("creator_member_id")
  costCC           Int      @map("cost_cc")
  playerUniqueCode String   @map("player_unique_code")
  note             String?

  participantList   MatchParticipant[]
  transactionRPList TransactionRP[]
  clubData          Club?              @relation(fields: [clubId], references: [id], onUpdate: Cascade, onDelete: SetNull)
  creatorMemberData ClubMember?        @relation(fields: [creatorMemberId], references: [id], onUpdate: Cascade, onDelete: SetNull)
  typeData          MatchType          @relation(fields: [typeId], references: [id], onUpdate: Cascade)

  @@map("match")
}

model MatchType {
  id                    Int      @id @default(autoincrement())
  name                  String
  defaultRankMultiplier Int      @map("default_rank_multiplier")
  modRankMultiplier     Int      @map("mod_rank_multiplier")
  modStartDate          DateTime @map("mod_start_date")
  modEndDate            DateTime @map("mod_end_date")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  official              Boolean  @default(false) @map("official")
  clubId                String?  @map("club_id") @db.Uuid
  ccBase                Float    @map("cc_base")
  ccNovice              Float    @map("cc_novice")
  ccAmateur             Float    @map("cc_amateur")
  ccPro                 Float    @map("cc_pro")
  totalScore            Int      @default(120000)

  matchList Match[]
  clubData  Club?   @relation(fields: [clubId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@map("match_type")
}

model MatchParticipant {
  userId        String  @map("player_id")
  matchId       String  @map("rank_id") @db.Uuid
  score         Int
  position      Int
  draw          Boolean
  seatRefId     Int
  playerRtId    Int     @map("player_rt_id")
  avgMatchSkill Float   @map("avg_match_skill")
  chombo        Int     @default(0)
  ron           Int?
  tsumo         Int?
  dealIn        Int?    @map("deal_in")
  gainUma       Int     @map("gain_uma")

  userData    User       @relation(fields: [userId], references: [id], onUpdate: Cascade)
  matchData   Match      @relation(fields: [matchId], references: [id], onUpdate: Cascade)
  matchRt     RankTittle @relation(fields: [playerRtId], references: [id], onUpdate: Cascade)
  seatRefData RefHelper  @relation(fields: [seatRefId], references: [id], onUpdate: Cascade)

  @@unique([userId, matchId])
  @@map("match_participant")
}

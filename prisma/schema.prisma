// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model RefHelper {
  ///general reference table
  id        Int      @id
  name      String
  notes     String?
  group     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  roleList       ClubMember[]
  rankTitleList  RankTittle[]
  userList       User[]       @relation(name: "role")
  genderList     User[]       @relation(name: "gender")
  clubStatusList Club[]

  @@map("reference_helper")
}

model User {
  // for general profile user
  id                     Int       @id @default(autoincrement())
  uuid                   String    @unique @default(uuid()) @db.Uuid
  fullName               String    @map("full_name")
  email                  String    @unique
  nationalityCountryCode String    @map("nationality_country_code")
  residenceCountryCode   String    @map("residence_country_code")
  dob                    DateTime? @map("dob")
  genderRefId            Int?      @map("gender_ref_id")
  district               String?
  address                String
  phoneCountry           String?   @map("phone_country")
  phone                  String?
  realId                 String?   @map("real_id")
  sourceRealId           String?   @map("source_real_id")
  joinedAt               DateTime  @default(now()) @map("joined_at")
  roleId                 Int       @default(101) @map("role_id")
  firebaseId             String    @unique @map("firebase_id")
  tncAgreement           Boolean?  @default(true) @map("tnc_agreement")
  banStatus              Boolean   @default(false) @map("ban_status")
  banReason              String?   @map("ban_reason")
  banedAt                DateTime? @map("baned_at")
  banExpiration          DateTime? @map("ban_expiration")
  telegramId             String?
  currentRP              Int       @default(0) @map("current_rp")
  currentTP              Int       @default(0) @map("current_mp")
  rtId                   Int       @default(1) @map("rt_id")
  rankedAt               DateTime  @default(now()) @map("ranked_at")

  metaData              UserMeta?
  rtData                RankTittle          @relation(fields: [rtId], references: [id])
  transactionCCList     TransactionCC[]
  roleData              RefHelper           @relation(name: "role", fields: [roleId], references: [id])
  genderData            RefHelper?          @relation(name: "gender", fields: [genderRefId], references: [id])
  clubList              ClubMember[]
  participantList       MatchParticipant[]
  clubUmaStandingList   ClubUmaStanding[]
  globalUmaStandingList GlobalUmaStanding[]

  @@unique([phoneCountry, phone])
  @@map("user")
}

model UserMeta {
  userId      Int      @unique @map("user_id")
  totalMatch  Int      @default(0) @map("total_match")
  totalChombo Int      @default(0) @map("total_chombo")
  totalFirst  Int      @default(0) @map("total_first")
  totalSecond Int      @default(0) @map("total_second")
  totalThird  Int      @default(0) @map("total_third")
  totalFourth Int      @default(0) @map("total_fourth")
  avgRon      Float    @default(0.0) @map("avg_ron")
  avgTsumo    Float    @default(0.0) @map("avg_tsumo")
  avgDealIn   Float    @default(0.0) @map("avg_deal_in")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  userData User @relation(fields: [userId], references: [id])

  @@map("user_meta")
}

model RankTittle {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  groupRefId  Int     @map("group_ref_id")
  skillIndex  Int
  first       Int
  second      Int
  third       Int
  fourth      Int
  baseRP      Int     @map("base_rp")
  promotionRP Int     @map("promotion_rp")
  demotion    Boolean
  clubLimit   Int     @default(1) @map("club_limit")

  userList        User[]
  participantList MatchParticipant[]
  group           RefHelper          @relation(fields: [groupRefId], references: [id])
  newRTList       TransactionRP[]    @relation("newRT")
  oldRTList       TransactionRP[]    @relation("oldRT")

  @@map("rank_title")
}

model Club {
  id              String   @id @default(uuid()) @db.Uuid
  slug            String   @unique
  name            String
  emblemFile      String?
  coverFile       String?
  description     String?
  countryISO2     String   @map("country_iso2")
  totalMember     Int      @default(0) @map("total_member")
  totalMainMember Int      @default(0) @map("total_main_member")
  maxAdmin        Int      @default(3) @map("max_admin")
  district        String?
  address         String?
  emailContact    String?  @map("email_contact")
  phoneContact    String?  @map("phone_contact")
  website         String?  @map("website")
  currentCC       Int      @default(0)
  spendCC         Int      @default(0)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  clubStatusId    Int      @map("club_status_id")
  upkeep          Int      @default(0)

  memberList      ClubMember[]
  transactionList TransactionCC[]
  matchList       Match[]
  statusData      RefHelper       @relation(fields: [clubStatusId], references: [id])
  clubSetting     ClubSetting?

  @@map("club")
}

model ClubSetting {
  clubId             String  @unique @map("club_id") @db.Uuid
  autoApproveMember  Boolean @default(false) @map("auto_approve_member")
  hideContact        Boolean @default(true)
  firstUma           Int     @default(150) @map("first_uma")
  secondUma          Int     @default(50) @map("second_uma")
  thirdUma           Int     @default(-50) @map("third_uma")
  fourthUma          Int     @default(-150) @map("fourth_uma")
  chomboPenalty      Int     @default(-300) @map("chombo_penalty")
  chomboPenaltyOther String? @map("chombo_penalty_other")
  yakumanBonus       Int     @default(0) @map("yakuman_bonus")
  yakumanBonusOther  String? @map("yakuman_bonus_other")
  acceptAutotable    Boolean @default(false) @map("accept_autotable")

  clubData Club @relation(fields: [clubId], references: [id])

  @@map("club_setting")
}

model ClubMember {
  id                  Int       @id @default(autoincrement())
  userId              Int       @map("player_id")
  clubId              String    @map("club_id") @db.Uuid
  roleId              Int       @map("role_id")
  createdAt           DateTime  @default(now()) @map("created_at")
  expiredAt           DateTime? @map("expired_at")
  active              Boolean   @default(true)
  canApproveMember    Boolean   @default(false) @map("can_approve_member")
  canEditClubInfo     Boolean   @default(false) @map("can_edit_info")
  canEditClubSetting  Boolean   @default(false) @map("can_edit_setting")
  canSubmitMatch      Boolean   @default(false) @map("can_submit_match")
  canSubmitTournament Boolean   @default(false) @map("can_submit_tournament")
  canBuyCC            Boolean   @default(false) @map("can_buy_cc")
  canEditAccess       Boolean   @default(false) @map("can_edit_access")

  clubData     Club      @relation(fields: [clubId], references: [id])
  userData     User      @relation(fields: [userId], references: [id])
  roleData     RefHelper @relation(fields: [roleId], references: [id])
  matchInputed Match[]

  @@map("club_member")
}

model ClubUmaStanding {
  id         String   @id @default(uuid()) @db.Uuid
  playerId   Int      @map("player_id")
  totalUma   Int      @map("total_uma")
  totalMatch Int      @default(0) @map("total_match")
  periode    DateTime

  userData User @relation(fields: [playerId], references: [id])

  @@map("club_uma_standing")
}

model GlobalUmaStanding {
  id         String   @id @default(uuid())
  playerId   Int      @map("player_id")
  totalUma   Int      @map("total_uma")
  totalMatch Int      @default(0) @map("total_match")
  periode    DateTime

  playerData User @relation(fields: [playerId], references: [id])

  @@map("global_uma_standing")
}

model TransactionCC {
  id        String   @id @default(uuid()) @db.Uuid
  clubId    String   @map("club_id") @db.Uuid
  userId    Int      @map("user_id")
  ccBefore  Int      @map("cc_before")
  ccMove    Int      @map("cc_move")
  ccAfter   Int      @map("cc_after")
  createdAt DateTime @default(now()) @map("created_at")
  type      Int
  note      String?

  clubData Club @relation(fields: [clubId], references: [id])
  userData User @relation(fields: [userId], references: [id])

  @@map("transaction_cc")
}

model TransactionRP {
  id         String   @id @default(uuid()) @db.Uuid
  matchId    String?  @db.Uuid
  note       String?
  rpBefore   Int      @map("rp_before")
  rpMove     Int      @map("rp_move")
  rpAfter    Int      @map("rp_after")
  rtChange   Boolean  @default(false) @map("rt_change")
  rtIdBefore Int?     @map("rt_id_before")
  rtIdAfter  Int?     @map("rt_id_after")
  createdAt  DateTime

  rtBeforeData RankTittle? @relation("oldRT", fields: [rtIdBefore], references: [id])
  rtAfterData  RankTittle? @relation("newRT", fields: [rtIdAfter], references: [id])
  matchData    Match?      @relation(fields: [matchId], references: [id])

  @@map("transaction_rp")
}

model Match {
  id               String   @id @default(uuid()) @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")
  matchAt          DateTime @map("match_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  type             Int
  officialRule     Boolean  @map("official_rule")
  clubId           String?  @map("club_id") @db.Uuid
  creatorMemberId  Int?     @map("creator_member_id")
  costCC           Int      @map("cost_cc")
  playerUniqueCode String   @map("player_unique_code")
  note             String?

  participantList   MatchParticipant[]
  transactionRPList TransactionRP[]
  clubData          Club?              @relation(fields: [clubId], references: [id])
  creatorMemberData ClubMember?        @relation(fields: [creatorMemberId], references: [id])

  @@map("match")
}

model MatchParticipant {
  userId        Int    @map("player_id")
  matchId       String @map("rank_id") @db.Uuid
  score         Int
  position      Int
  playerRtId    Int    @map("player_rt_id")
  avgMatchSkill Float  @map("avg_match_skill")
  chombo        Int    @default(0)
  ron           Int?
  tsumo         Int?
  dealIn        Int?   @map("deal_in")
  gainUma       Int    @map("gain_uma")

  userData  User       @relation(fields: [userId], references: [id])
  matchData Match      @relation(fields: [matchId], references: [id])
  matchRt   RankTittle @relation(fields: [playerRtId], references: [id])

  @@unique([userId, matchId])
  @@map("match_participant")
}
